# Local: copy to .env.local. Netlify: add these under Site configuration → Environment variables.
APP_PASSCODE=change-me
# Random string that signs the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-64-hex-chars

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Database. Leave empty locally to use the file data/app.db.
# Netlify: your Turso database URL (libsql://<db>-<org>.turso.io) and a token from `turso db tokens create <db>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Netlify only: random string shared with the scheduled Strava sync function.
CRON_SECRET=

# Optional: pretend "today" is this date (YYYY-MM-DD) for demos and acceptance checks
# APP_TODAY=2026-11-16
